<% return unless timeline.renderable? %>

<div class="<%= local_assigns[:wrapper_class].presence || 'mb-3' %>">
  <div class="h-section-label">Print timeline</div>
  <div class="job-timeline">
    <div class="job-timeline__labels text-12 text-secondary d-flex justify-content-between mb-1">
      <span><%= job_timeline_start_label(timeline) %></span>
      <span><%= job_timeline_end_label(timeline) %></span>
    </div>

    <div class="job-timeline__bar" role="img" aria-label="Print status timeline for <%= job.filename %>">
      <% timeline.segments.each do |segment| %>
        <div class="job-timeline__segment <%= segment.css_class %>"
             style="left: <%= segment.left_percent %>%; width: <%= segment.width_percent %>%;"
             title="<%= segment.title %>"></div>
      <% end %>
    </div>

    <% if timeline.markers.any? %>
      <div class="job-timeline__marks" aria-hidden="true">
        <% timeline.markers.each do |marker| %>
          <div class="job-timeline__mark" style="left: <%= marker.position_percent %>%;" title="<%= marker.title %>">
            <span class="job-timeline__mark-tick"></span>
            <span class="job-timeline__mark-label <%= marker.css_class %>"><%= marker.short_label %></span>
          </div>
        <% end %>
      </div>

      <div class="job-timeline__legend text-12 text-secondary mt-2 d-flex flex-wrap gap-3">
        <span><span class="job-timeline__legend-swatch job-timeline-segment--printing"></span> Printing</span>
        <span><span class="job-timeline__legend-swatch job-timeline-segment--attention"></span> Attention / error</span>
        <span><span class="job-timeline__legend-swatch job-timeline-segment--paused"></span> Paused</span>
        <span class="text-secondary">Marks: S start · A attention · E error · P paused · F finished</span>
      </div>
    <% end %>
  </div>
</div>
