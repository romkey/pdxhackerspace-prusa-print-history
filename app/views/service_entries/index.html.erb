<div class="container py-4">
  <div class="d-flex align-items-end justify-content-between flex-wrap gap-2 mb-3">
    <div>
      <h1 class="h-page-title mb-0">
        Service log<%= " · #{@printer.name}" if @printer %>
      </h1>
      <div class="text-13 text-secondary mt-1">
        <% if @listing.open_problem_count.positive? %>
          <span class="text-warning fw-medium"><%= @listing.open_problem_count %></span>
          open <%= 'problem'.pluralize(@listing.open_problem_count) %>
        <% else %>
          <span class="text-secondary">No open problems</span>
        <% end %>
        <% if @printer&.out_of_service? %>
          · <span class="text-warning">out of service</span>
        <% elsif @printer.nil? && @listing.out_of_service_count.positive? %>
          · <span class="text-warning fw-medium"><%= @listing.out_of_service_count %></span>
          out of service
        <% end %>
        <% if @listing.filter_count.positive? %>
          · <%= pluralize(@listing.filter_count, 'filter') %> active ·
          <%= link_to 'Clear', service_log_location(@printer), class: 'text-decoration-none' %>
        <% end %>
      </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to 'Report a problem', new_problem_report_path(printer_id: @printer&.id), class: 'btn btn-primary btn-sm' %>
      <% if logged_in? %>
        <%= link_to 'Log a repair', new_repair_entry_path(printer_id: @printer&.id), class: 'btn btn-outline-secondary btn-sm' %>
        <% if @printer&.out_of_service? %>
          <%= button_to 'Return to service', return_to_service_printer_path(@printer), method: :delete,
                        class: 'btn btn-outline-secondary btn-sm' %>
        <% elsif @printer %>
          <%= link_to 'Take out of service', new_out_of_service_printer_path(@printer), class: 'btn btn-outline-secondary btn-sm' %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @printer %>
    <%= render 'reliability', score: @scores.find { |row| row.printer.id == @printer.id } %>
  <% else %>
    <%= render 'summary', scores: @scores, open_counts: @open_counts %>
  <% end %>

  <%= render 'filters' %>

  <% if @entries.any? %>
    <div class="card">
      <table class="table table-compact mb-0">
        <thead>
          <tr>
            <th>When</th>
            <th>Printer</th>
            <th>Type</th>
            <th>Summary</th>
            <th>By</th>
            <% if logged_in? %><th></th><% end %>
          </tr>
        </thead>
        <tbody>
          <% @entries.each do |entry| %>
            <tr>
              <td class="text-secondary text-13" title="<%= l(entry.occurred_at, format: :precise) %>">
                <%= relative_timestamp(entry.occurred_at) %>
              </td>
              <td><%= link_to entry.printer.name, service_printer_path(entry.printer), class: 'text-decoration-none' %></td>
              <td>
                <span class="status-dot <%= service_entry_dot_class(entry) %> me-1"></span>
                <%= service_entry_kind_label(entry) %>
                <% if entry.open_problem? %>
                  <span class="badge text-bg-warning-subtle ms-1">Open</span>
                <% elsif entry.resolved_problem? %>
                  <span class="text-secondary text-12 ms-1">Resolved</span>
                <% end %>
              </td>
              <td>
                <%= entry.summary %>
                <% if entry.details.present? %>
                  <details class="text-12 text-secondary">
                    <summary>Details</summary>
                    <%= simple_format(entry.details) %>
                  </details>
                <% end %>
              </td>
              <td class="text-13"><%= service_entry_author(entry) %></td>
              <% if logged_in? %>
                <td class="text-end">
                  <% if entry.open_problem? %>
                    <%= button_to 'Resolve', resolve_problem_path(entry), method: :patch,
                                  class: 'btn btn-outline-secondary btn-sm' %>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="mt-3">
        <%== @pagy.series_nav(:bootstrap, anchor_string: 'data-turbo-action="advance"') %>
      </div>
    <% end %>
  <% else %>
    <p class="text-secondary">No service log entries yet.</p>
  <% end %>
</div>
