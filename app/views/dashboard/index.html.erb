<div class="container py-4 dashboard-page">
  <div class="text-center mb-4">
    <h1 class="h-page-title mb-1"><%= dashboard_heading %></h1>
    <div class="text-13 text-secondary"
         data-controller="clock"
         data-clock-initial-value="<%= l(Time.current, format: :dashboard_clock) %>">
      <time data-clock-target="display"><%= l(Time.current, format: :dashboard_clock) %></time>
    </div>
    <% if admin? %>
      <div class="mt-2">
        <%= link_to 'Manage printers', printers_path, class: 'btn btn-outline-secondary btn-sm' %>
      </div>
    <% end %>
  </div>

  <% if @presenter.cards.any? %>
    <div class="row g-3 mb-3">
      <% @presenter.cards.each do |card| %>
        <div class="col-6 col-lg-3">
          <%= render 'dashboard/printer_card', card: card %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card mb-3">
      <div class="card-body text-13 text-secondary text-center">
        No printers configured yet.
        <% if admin? %>
          <%= link_to 'Add one', new_printer_path %>.
        <% end %>
      </div>
    </div>
  <% end %>
</div>
