<div class="d-flex flex-wrap gap-2 mb-2">
  <% service_kind_filters.each do |value, label| %>
    <%= link_to label, service_filter_href(:kind, value, @printer), class: service_filter_chip_class(:kind, value) %>
  <% end %>
</div>
<div class="d-flex flex-wrap gap-2 <%= @printer ? 'mb-3' : 'mb-2' %>">
  <% service_state_filters.each do |value, label| %>
    <%= link_to label, service_filter_href(:state, value, @printer), class: service_filter_chip_class(:state, value) %>
  <% end %>
</div>
<% unless @printer %>
  <div class="d-flex flex-wrap gap-2 mb-3">
    <% @printers.each do |printer| %>
      <%= link_to printer.name, service_filter_href(:printer_id, printer.id, @printer),
                  class: service_filter_chip_class(:printer_id, printer.id) %>
    <% end %>
  </div>
<% end %>
