<% job = local_assigns.fetch(:job) %>
<% wrapper_class = local_assigns[:wrapper_class] %>

<% if job_progress_visible?(job) %>
  <% bar_percent = job_progress_bar_percent(job) %>
  <% timeline_mode = job_progress_timeline?(job) %>
  <div class="<%= wrapper_class if wrapper_class.present? %>">
    <div class="progress job-progress<%= ' job-progress--timeline' if timeline_mode %>" style="height: 8px;">
      <div class="progress-bar" role="progressbar"
           style="width: <%= bar_percent %>%"
           aria-valuenow="<%= bar_percent.round(0) %>"
           aria-valuemin="0"
           aria-valuemax="100"></div>
    </div>
    <div class="text-13 text-secondary mt-1">
      <% if job.progress_percent.present? %>
        <span class="text-body num fw-medium"><%= job.progress_percent.to_f.round(0) %>%</span>
      <% end %>
      <% if job.estimated_finish_at.present? %>
        &middot; <%= job_eta_label(job) %>
      <% end %>
      <% if job.time_printing_seconds.present? %>
        &middot; <%= distance_of_time_in_words(job.time_printing_seconds) %> elapsed
      <% end %>
    </div>
  </div>
<% end %>
