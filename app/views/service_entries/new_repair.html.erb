<div class="container py-4">
  <div class="row">
    <div class="col-lg-8">
      <div class="mb-3">
        <div class="text-13 text-secondary">
          <%= link_to 'Service log', service_log_location(@printer), class: 'text-decoration-none' %>
        </div>
        <h1 class="h-page-title mb-0">Log a repair</h1>
      </div>

      <%= form_with url: new_repair_entry_path, method: :get, class: 'mb-3' do %>
        <label class="form-label" for="repair_printer_id">Printer</label>
        <%= select_tag :printer_id,
                       options_from_collection_for_select(@printers, :id, :name, @printer&.id),
                       include_blank: 'Choose a printer',
                       class: 'form-select',
                       id: 'repair_printer_id',
                       onchange: 'this.form.requestSubmit()' %>
      <% end %>

      <% if @printer %>
        <%= form_with model: @entry, url: repair_entries_path do |f| %>
          <%= render 'errors', entry: @entry %>
          <%= f.hidden_field :printer_id, value: @printer.id %>

          <div class="mb-3">
            <%= f.label :summary, 'Summary', class: 'form-label' %>
            <%= f.text_field :summary, class: 'form-control', required: true, maxlength: 200 %>
          </div>
          <div class="mb-3">
            <%= f.label :details, 'Details', class: 'form-label' %>
            <%= f.text_area :details, class: 'form-control', rows: 4 %>
          </div>
          <div class="mb-3">
            <%= f.label :occurred_at, 'When', class: 'form-label' %>
            <%= f.datetime_field :occurred_at,
                                 value: (@entry.occurred_at || Time.current).strftime('%Y-%m-%dT%H:%M'),
                                 class: 'form-control' %>
          </div>

          <% if @open_problems.any? %>
            <div class="mb-3">
              <div class="h-section-label mb-2">Resolves</div>
              <%= hidden_field_tag 'service_entry[resolves][]', '' %>
              <% @open_problems.each do |problem| %>
                <div class="form-check">
                  <%= check_box_tag 'service_entry[resolves][]', problem.id, resolve_checked?(problem),
                                    class: 'form-check-input', id: "resolve_problem_#{problem.id}" %>
                  <%= label_tag "resolve_problem_#{problem.id}", problem.summary, class: 'form-check-label' %>
                </div>
              <% end %>
            </div>
          <% end %>

          <%= hidden_field_tag 'service_entry[return_to_service]', '0' %>
          <% if @printer.out_of_service? %>
            <div class="form-check mb-3">
              <%= check_box_tag 'service_entry[return_to_service]', '1',
                                ActiveModel::Type::Boolean.new.cast(params.dig(:service_entry, :return_to_service)),
                                class: 'form-check-input', id: 'return_to_service' %>
              <%= label_tag 'return_to_service', 'Return to service', class: 'form-check-label' %>
            </div>
          <% end %>

          <%= f.submit 'Log a repair', class: 'btn btn-primary btn-sm' %>
        <% end %>
      <% else %>
        <p class="text-secondary text-13">Choose a printer to log a repair.</p>
      <% end %>
    </div>
  </div>
</div>
