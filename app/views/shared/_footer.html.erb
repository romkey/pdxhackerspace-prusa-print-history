<footer class="border-top mt-4 py-3">
  <div class="container text-12 text-center text-secondary">
    <span><%= footer_text %></span>
    <% if Setting.footer_link_label.present? && Setting.footer_link_url.present? %>
      <span class="mx-1">&middot;</span>
      <%= link_to Setting.footer_link_label, Setting.footer_link_url, target: '_blank', rel: 'noopener' %>
    <% end %>
    <span class="mx-1">&middot;</span>
    <%= link_to 'PDX Hackerspace', pdx_hackerspace_url, target: '_blank', rel: 'noopener' %>
    <span class="mx-1">&middot;</span>
    <%= link_to 'GitHub', github_repo_url, target: '_blank', rel: 'noopener' %>
  </div>
</footer>
