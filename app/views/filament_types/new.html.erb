<div class="container py-4" style="max-width: 880px;">
  <div class="d-flex align-items-end justify-content-between mb-3">
    <div>
      <div class="text-13 text-secondary">
        <%= link_to 'Settings', settings_path, class: 'text-decoration-none' %> /
        <%= link_to 'Filament types', filament_types_path, class: 'text-decoration-none' %>
      </div>
      <h1 class="h-page-title mb-0">Add filament type</h1>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <%= render 'form', filament_type: @filament_type %>
    </div>
  </div>
</div>
