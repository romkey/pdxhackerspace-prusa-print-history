<div class="container py-4" style="max-width: 880px;">
  <div class="d-flex align-items-end justify-content-between mb-3">
    <div>
      <div class="text-13 text-secondary">
        <%= link_to 'Settings', settings_path, class: 'text-decoration-none' %> / Label printers
      </div>
      <h1 class="h-page-title mb-0">Label printers</h1>
      <div class="text-13 text-secondary mt-1">
        CUPS printers for print job labels
      </div>
    </div>
    <div>
      <%= link_to '+ Add label printer', new_label_printer_path, class: 'btn btn-primary btn-sm' %>
    </div>
  </div>

  <% if @cups_printers.any? %>
    <div class="card mb-3">
      <div class="card-body">
        <div class="h-section-label">Detected CUPS printers</div>
        <div class="text-13 text-secondary mb-2">
          Printers visible from this server via <code>lpstat</code>.
        </div>
        <table class="table table-compact mb-0">
          <thead>
            <tr>
              <th>Queue</th>
              <th>Status</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <% @cups_printers.each do |cp| %>
              <tr>
                <td class="fw-medium"><%= cp[:name] %></td>
                <td class="text-secondary text-13"><%= cp[:status] %></td>
                <td class="text-secondary text-13"><%= cp[:description].presence || '—' %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="alert alert-warning text-13 mb-3">
      No CUPS printers detected. Install <code>cups-client</code> and configure a CUPS server, or enter queue names manually.
    </div>
  <% end %>

  <div class="card">
    <div class="card-body">
      <div class="h-section-label">Configured label printers</div>
      <% if @label_printers.any? %>
        <table class="table table-compact mb-0">
          <thead>
            <tr>
              <th>Name</th>
              <th>CUPS destination</th>
              <th>Paper</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @label_printers.each do |printer| %>
              <tr>
                <td>
                  <%= printer.name %>
                  <% if printer.default_printer? %>
                    <span class="badge text-bg-secondary-subtle ms-1">Default</span>
                  <% end %>
                </td>
                <td class="text-secondary text-13"><%= printer.cups_destination %></td>
                <td class="text-secondary text-13"><%= printer.receipt_paper_summary %></td>
                <td class="text-end">
                  <div class="d-flex gap-1 justify-content-end">
                    <%= button_to 'Test', test_print_label_printer_path(printer), method: :post,
                                  class: 'btn btn-outline-secondary btn-sm' %>
                    <%= link_to 'Edit', edit_label_printer_path(printer), class: 'btn btn-outline-secondary btn-sm' %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-secondary mb-2">No label printers configured yet.</p>
        <%= link_to '+ Add label printer', new_label_printer_path, class: 'btn btn-primary btn-sm' %>
      <% end %>
    </div>
  </div>
</div>
