<div class="container py-4">
  <div class="d-flex align-items-end justify-content-between mb-3">
    <div>
      <h1 class="h-page-title mb-0">
        <%= params[:owner] == 'me' ? 'My prints' : 'Jobs' %>
      </h1>
      <div class="text-13 text-secondary mt-1">
        <%= pluralize(@pagy.count, 'job') %>
      </div>
    </div>
  </div>

  <% if @jobs.any? %>
    <% show_actions_column = @jobs.any? { |job| job_show_claim_button?(job) || job_show_clear_button?(job) } %>
    <div class="card">
      <table class="table table-compact mb-0">
        <thead>
          <tr>
            <th class="job-list-thumbs-col"></th>
            <th>File</th>
            <th>Printer</th>
            <th>Status</th>
            <th>Owner</th>
            <th>Started</th>
            <th>Ended</th>
            <% if show_actions_column %>
              <th>Actions</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @jobs.each do |job| %>
            <tr>
              <td class="job-list-thumbs-col">
                <%= render 'jobs/thumbnails', job: job %>
              </td>
              <td><%= link_to job.filename, job_path(job), class: 'fw-medium' %></td>
              <td><%= link_to job.printer.name, printer_path(job.printer), class: 'text-decoration-none' %></td>
              <td>
                <% if job.active? %>
                  <span class="status-dot status-success me-1"></span>
                <% elsif job.status == 'finished' %>
                  <span class="status-dot status-muted me-1"></span>
                <% elsif %w[error cancelled].include?(job.status) %>
                  <span class="status-dot status-danger me-1"></span>
                <% end %>
                <%= job.status %>
              </td>
              <td class="text-secondary"><%= job.owner&.display_name || '—' %></td>
              <td class="text-secondary text-13" title="<%= job.started_at && l(job.started_at, format: :precise) %>">
                <%= job.started_at ? l(job.started_at, format: :short) : '—' %>
              </td>
              <td class="text-secondary text-13" title="<%= job.ended_at && l(job.ended_at, format: :precise) %>">
                <%= job.ended_at ? l(job.ended_at, format: :short) : '—' %>
              </td>
              <% if show_actions_column %>
                <td class="text-nowrap">
                  <%= render 'jobs/actions',
                             job: job,
                             label_printers: @label_printers,
                             default_label_printer: @default_label_printer %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="mt-3">
        <%== pagy_bootstrap_nav(@pagy) %>
      </div>
    <% end %>
  <% else %>
    <p class="text-secondary">No jobs recorded yet.</p>
  <% end %>
</div>
