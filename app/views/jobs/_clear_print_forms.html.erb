<% job = local_assigns.fetch(:job) %>
<% label_printers = local_assigns.fetch(:label_printers, LabelPrinter.ordered) %>
<% default_label_printer = local_assigns[:default_label_printer] || LabelPrinter.default %>
<% reason_id = dom_id(job, :clear_failure_reason) %>
<% detail_wrap_id = dom_id(job, :clear_failure_detail_wrap) %>
<% detail_id = dom_id(job, :clear_failure_detail) %>

<div data-controller="clear-print-form">
  <% if label_printers.any? %>
    <%= form_with url: clear_print_job_path(job), method: :post, local: true, class: 'mb-3' do %>
      <%= hidden_field_tag :outcome, 'success' %>
      <% if label_printers.many? %>
        <div class="mb-2">
          <%= label_tag dom_id(job, :label_printer_id), 'Label printer', class: 'form-label text-13' %>
          <%= select_tag :label_printer_id,
                         options_from_collection_for_select(label_printers, :id, :name, default_label_printer&.id),
                         class: 'form-select form-select-sm',
                         id: dom_id(job, :label_printer_id) %>
        </div>
      <% end %>
      <%= submit_tag 'Successful, print label', class: 'btn btn-outline-secondary btn-sm' %>
    <% end %>
  <% else %>
    <p class="text-13 text-secondary mb-3">Configure a label printer to print pickup labels on success.</p>
  <% end %>

  <%= form_with url: clear_print_job_path(job), method: :post, local: true do %>
    <%= hidden_field_tag :outcome, 'failed' %>
    <div class="mb-2">
      <%= label_tag reason_id, 'Failure reason', class: 'form-label text-13' %>
      <%= select_tag :failure_reason,
                     options_for_select(Job::CLEAR_FAILURE_REASONS.map { |key, label| [label, key] }),
                     class: 'form-select form-select-sm',
                     required: true,
                     id: reason_id,
                     data: { clear_print_form_target: 'reason', action: 'change->clear-print-form#syncDetail' } %>
    </div>
    <div class="mb-2" id="<%= detail_wrap_id %>" hidden data-clear-print-form-target="detailWrap">
      <%= label_tag detail_id, 'Details', class: 'form-label text-13' %>
      <%= text_field_tag :failure_detail, nil,
                         class: 'form-control form-control-sm',
                         id: detail_id,
                         data: { clear_print_form_target: 'detail' } %>
    </div>
    <%= submit_tag 'Failed', class: 'btn btn-outline-secondary btn-sm' %>
  <% end %>
</div>
