<div class="container py-5" style="max-width: 520px;">
  <div class="card">
    <div class="card-body text-center">
      <h1 class="h-page-title mb-1">Sign in</h1>
      <p class="text-13 text-secondary mb-4">
        Sign in to claim prints and access admin features.
        Anonymous visitors can still view all printer and job pages.
      </p>

      <% if LocalAdmin.configured? %>
        <%= form_tag local_login_path, method: :post, class: 'text-start mb-4', data: { turbo: false } do %>
          <div class="mb-3">
            <%= label_tag :email, 'Email', class: 'form-label' %>
            <%= email_field_tag :email, LocalAdmin.email, class: 'form-control', required: true, autocomplete: 'username' %>
          </div>
          <div class="mb-3">
            <%= label_tag :password, 'Password', class: 'form-label' %>
            <%= password_field_tag :password, nil, class: 'form-control', required: true, autocomplete: 'current-password' %>
          </div>
          <%= submit_tag 'Sign in', class: 'btn btn-primary w-100' %>
        <% end %>
      <% end %>

      <% if ENV['AUTHENTIK_ISSUER'].present? %>
        <% if LocalAdmin.configured? %>
          <p class="text-13 text-secondary mb-2">Or sign in with Authentik</p>
        <% end %>
        <%= button_to '/auth/authentik', method: :post, class: 'btn btn-outline-secondary w-100', data: { turbo: false } do %>
          <i class="bi bi-shield-lock me-2"></i> Sign in with Authentik
        <% end %>
      <% elsif !LocalAdmin.configured? %>
        <p class="text-warning text-13 mb-3">No sign-in method is configured on this server.</p>
      <% end %>

      <% if Rails.env.local? %>
        <hr>
        <p class="text-13 text-secondary mb-2">Developer login</p>
        <%= button_to '/auth/developer', method: :post, class: 'btn btn-outline-secondary w-100', data: { turbo: false } do %>
          Sign in (developer)
        <% end %>
      <% end %>
    </div>
  </div>
</div>
