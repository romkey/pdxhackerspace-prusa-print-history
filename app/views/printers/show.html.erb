<div class="container py-4">
  <div class="d-flex align-items-end justify-content-between mb-3">
    <div>
      <div class="text-13 text-secondary">
        <%= link_to 'Printers', printers_path, class: 'text-decoration-none' %>
      </div>
      <h1 class="h-page-title mb-0 d-flex align-items-center gap-2">
        <span id="<%= dom_id(@printer, :prusalink_status) %>">
          <%= render 'printers/prusalink_status_dot', printer: @printer %>
        </span>
        <%= @printer.name %>
      </h1>
      <div class="text-13 text-secondary mt-1">
        <%= @printer.model.presence || 'Unknown model' %>
        &middot; <%= @printer.location.presence || 'No location' %>
        &middot; <%= @printer.hostname %>
        &middot; <%= render 'shared/printer_status', printer: @printer %>
      </div>
    </div>
    <% if admin? %>
      <div>
        <%= link_to edit_printer_path(@printer),
                    class: 'btn btn-outline-secondary btn-sm',
                    title: 'Printer settings' do %>
          <i class="bi bi-gear"></i> Settings
        <% end %>
      </div>
    <% end %>
  </div>

  <%= turbo_stream_from @printer %>

  <div id="<%= dom_id(@printer, :live) %>">
    <%= render 'printers/live_panel', printer: @printer, presenter: @presenter %>
  </div>
</div>
