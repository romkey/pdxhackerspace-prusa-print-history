<div class="container py-4" style="max-width: 880px;">
  <div class="mb-3">
    <h1 class="h-page-title mb-0">Settings</h1>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      <div class="h-section-label">Default ambient temperature sensor</div>
      <%= form_with url: settings_path, method: :patch, local: true do |f| %>
        <div class="row g-3 align-items-end">
          <div class="col-md-9">
            <%= label_tag 'settings[default_ambient_sensor]', 'Home Assistant entity ID', class: 'form-label' %>
            <%= text_field_tag 'settings[default_ambient_sensor]', @ambient_sensor,
                               class: 'form-control', placeholder: 'sensor.shop_ambient_temperature' %>
          </div>
          <div class="col-md-3">
            <%= f.submit 'Save', class: 'btn btn-primary w-100' %>
          </div>
        </div>

        <hr class="my-4">

        <div class="h-section-label">Dashboard</div>
        <div class="mb-3">
          <%= label_tag 'settings[dashboard_heading]', 'Heading', class: 'form-label' %>
          <%= text_field_tag 'settings[dashboard_heading]', @dashboard_heading,
                             class: 'form-control', placeholder: 'PDX Hackerspace 3D Printers' %>
        </div>

        <div class="h-section-label mt-4">Footer</div>
        <div class="mb-3">
          <%= label_tag 'settings[footer_text]', 'Text', class: 'form-label' %>
          <%= text_field_tag 'settings[footer_text]', @footer_text,
                             class: 'form-control', placeholder: 'PDX Hackerspace 3D Printing' %>
        </div>
        <div class="row g-3">
          <div class="col-md-6">
            <%= label_tag 'settings[footer_link_label]', 'Link label', class: 'form-label' %>
            <%= text_field_tag 'settings[footer_link_label]', @footer_link_label,
                               class: 'form-control', placeholder: 'FAQ' %>
          </div>
          <div class="col-md-6">
            <%= label_tag 'settings[footer_link_url]', 'Link URL', class: 'form-label' %>
            <%= url_field_tag 'settings[footer_link_url]', @footer_link_url,
                              class: 'form-control', placeholder: 'https://example.com/faq' %>
          </div>
        </div>

        <hr class="my-4">

        <div class="h-section-label">Data retention</div>
        <p class="text-13 text-secondary mb-3">
          A nightly job deletes camera photos and preview images older than this. Job history
          (jobs, events and telemetry) is only deleted when enabled below; active jobs are never removed.
        </p>
        <div class="row g-3 align-items-end">
          <div class="col-md-4">
            <%= label_tag 'settings[image_retention_months]', 'Keep images for (months)', class: 'form-label' %>
            <%= number_field_tag 'settings[image_retention_months]', @image_retention_months,
                                 class: 'form-control', min: 1 %>
          </div>
          <div class="col-md-4">
            <%= label_tag 'settings[job_history_retention_months]', 'Keep job history for (months)', class: 'form-label' %>
            <%= number_field_tag 'settings[job_history_retention_months]', @job_history_retention_months,
                                 class: 'form-control', min: 1 %>
          </div>
          <div class="col-md-4">
            <div class="form-check">
              <%= hidden_field_tag 'settings[delete_job_history]', '0', id: nil %>
              <%= check_box_tag 'settings[delete_job_history]', '1', @delete_job_history, class: 'form-check-input' %>
              <%= label_tag 'settings[delete_job_history]', 'Delete old job history', class: 'form-check-label' %>
            </div>
          </div>
        </div>

        <hr class="my-4">

        <div class="h-section-label">Prusa training notice</div>
        <p class="text-13 text-secondary mb-3">
          Shown as a warning when a member signs in via Authentik without Prusa in their
          <code>trained_on</code> claim.
        </p>
        <div class="mb-3">
          <%= label_tag 'settings[prusa_untrained_message]', 'Not trained message', class: 'form-label' %>
          <%= text_area_tag 'settings[prusa_untrained_message]', @prusa_untrained_message,
                            class: 'form-control', rows: 3 %>
        </div>
        <div class="mb-0">
          <%= label_tag 'settings[prusa_trained_account_message]', 'Already trained message', class: 'form-label' %>
          <%= text_area_tag 'settings[prusa_trained_account_message]', @prusa_trained_account_message,
                            class: 'form-control', rows: 2 %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card mb-3" id="api">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-baseline">
        <div class="h-section-label">API and tokens</div>
        <div class="text-13">
          <%= link_to 'All tokens', api_tokens_path, class: 'text-decoration-none' %> &middot;
          <%= link_to 'API reference', api_v1_docs_path, class: 'text-decoration-none' %>
        </div>
      </div>
      <%= form_with url: settings_path, method: :patch, local: true do |f| %>
        <%= render 'settings/check_box', key: :api_enabled, label: 'Turn on the API',
                                         checked: Setting.api_enabled?,
                                         hint: 'When off, every API request is refused. Tokens are kept.' %>
        <%= render 'settings/check_box', key: :api_require_internal_network, label: 'Only accept API requests from the shop network',
                                         checked: Setting.api_require_internal_network?,
                                         hint: 'Uses INTERNAL_NETWORKS. Individual tokens can also be limited to addresses.' %>

        <div class="h-section-label mt-4">Members</div>
        <%= render 'settings/check_box', key: :api_members_can_create_tokens, label: 'Members can create their own tokens',
                                         checked: Setting.api_members_can_create_tokens?,
                                         hint: 'When off, only admins issue tokens, including tokens for members.' %>
        <%= render 'settings/check_box', key: :members_can_undo_clear, label: 'Members can undo a clear',
                                         checked: Setting.members_can_undo_clear?,
                                         hint: 'Applies on the web and through the API. Admins always can.' %>
        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <%= label_tag 'settings[api_member_max_access_level]', 'Highest access for member tokens', class: 'form-label' %>
            <%= select_tag 'settings[api_member_max_access_level]',
                           options_for_select(ApiToken::ACCESS_LEVEL_LABELS.invert, Setting.api_member_max_access_level),
                           class: 'form-select' %>
          </div>
          <%= render 'settings/days_field', key: :api_member_token_default_days, label: 'Default lifetime (days)',
                                            value: Setting.api_member_token_default_days, blank: 'never expires' %>
          <%= render 'settings/days_field', key: :api_member_token_max_days, label: 'Maximum lifetime (days)',
                                            value: Setting.api_member_token_max_days, blank: 'no limit' %>
        </div>

        <div class="h-section-label mt-4">Admins</div>
        <div class="row g-3 mb-3">
          <%= render 'settings/days_field', key: :api_admin_token_default_days, label: 'Default lifetime (days)',
                                            value: Setting.api_admin_token_default_days, blank: 'never expires' %>
          <%= render 'settings/days_field', key: :api_admin_token_max_days, label: 'Maximum lifetime (days)',
                                            value: Setting.api_admin_token_max_days, blank: 'no limit' %>
        </div>

        <div class="h-section-label mt-4">All tokens</div>
        <div class="row g-3 mb-3">
          <%= render 'settings/days_field', key: :api_token_renew_grace_days, label: 'Renew after expiry within (days)',
                                            value: Setting.api_token_renew_grace_days, blank: 'expired tokens cannot be renewed' %>
          <%= render 'settings/days_field', key: :api_token_max_login_age_days, label: 'Require a sign-in within (days)',
                                            value: Setting.api_token_max_login_age_days,
                                            blank: 'off. When set, a token stops working if its owner has not signed in for this long' %>
        </div>

        <div class="h-section-label mt-4">Sign-in links</div>
        <%= render 'settings/check_box', key: :login_links_enabled, label: 'Members can ask for a sign-in link through the API',
                                         checked: Setting.login_links_enabled?,
                                         hint: 'Emailed to the member, or shown as a QR code on a kiosk allowed to do so. Single use.' %>
        <%= render 'settings/check_box', key: :login_links_allow_admins, label: 'Admins can use sign-in links too',
                                         checked: Setting.login_links_allow_admins?,
                                         hint: 'Off by default: a link signs in without Authentik, so admin rights are not re-checked.' %>
        <div class="row g-3 mb-3">
          <%= render 'settings/days_field', key: :login_link_ttl_minutes, label: 'Emailed links expire after (minutes)',
                                            value: Setting.login_link_ttl_minutes, blank: '60 minutes' %>
          <%= render 'settings/days_field', key: :login_link_qr_ttl_minutes, label: 'QR code links expire after (minutes)',
                                            value: Setting.login_link_qr_ttl_minutes, blank: '5 minutes' %>
        </div>

        <div class="h-section-label mt-4">Kiosks</div>
        <div class="row g-3 mb-3">
          <%= render 'settings/days_field', key: :api_kiosk_session_minutes, label: 'Kiosk sessions last (minutes)',
                                            value: Setting.api_kiosk_session_minutes, blank: '2 minutes' %>
        </div>

        <%= f.submit 'Save API settings', class: 'btn btn-outline-secondary' %>
      <% end %>
    </div>
  </div>

  <div class="card mb-3" id="prusa-connect-account">
    <div class="card-body">
      <div class="h-section-label">Prusa Connect account</div>
      <p class="text-secondary text-13">
        Lets the app read detailed error reasons from Prusa Connect. Log in once with a tool such as
        <code>prusactl auth login</code>, then paste the refresh token here. It is encrypted at rest and replaced
        automatically when Prusa rotates it. Set each printer's Connect UUID on its edit page.
      </p>
      <% if @prusa_connect&.configured? %>
        <div class="d-flex align-items-center gap-2">
          <span class="status-dot <%= @prusa_connect.last_error.present? ? 'status-danger' : 'status-success' %>"></span>
          <span class="fw-medium"><%= @prusa_connect.last_error.present? ? 'Needs attention' : 'Token saved' %></span>
          <% if @prusa_connect.last_synced_at %>
            <span class="text-13 text-secondary">Last used <%= time_ago_in_words(@prusa_connect.last_synced_at) %> ago</span>
          <% end %>
        </div>
        <% if @prusa_connect.last_error.present? %>
          <div class="alert alert-warning mt-2 text-13"><%= @prusa_connect.last_error %></div>
        <% end %>
      <% end %>
      <%= form_with url: prusa_connect_credential_path, method: :patch, local: true, class: 'mt-2' do %>
        <%= label_tag :refresh_token, 'Refresh token', class: 'form-label' %>
        <%= password_field_tag :refresh_token, nil, class: 'form-control', autocomplete: 'new-password' %>
        <div class="mt-2 d-flex gap-2">
          <%= submit_tag 'Save token', class: 'btn btn-outline-secondary' %>
          <% if @prusa_connect&.configured? %>
            <%= button_to 'Remove', prusa_connect_credential_path, method: :delete, class: 'btn btn-outline-danger',
                          form: { data: { turbo_confirm: 'Remove the saved Prusa Connect token?' } } %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card mb-3" id="ha-health">
    <div class="card-body">
      <div class="h-section-label">Home Assistant health</div>
      <% status = @home_assistant[:status] %>
      <div class="d-flex align-items-center gap-2">
        <% case status %>
        <% when 'ok' %>
          <span class="status-dot status-success"></span>
          <span class="fw-medium">Reachable</span>
        <% when 'unreachable' %>
          <span class="status-dot status-danger"></span>
          <span class="fw-medium">Unreachable</span>
        <% when 'not_configured' %>
          <span class="status-dot status-muted"></span>
          <span class="fw-medium">Not configured</span>
        <% else %>
          <span class="status-dot status-muted"></span>
          <span class="text-secondary">Status unknown</span>
        <% end %>
      </div>
      <% if @home_assistant[:polled_at] %>
        <div class="text-13 text-secondary mt-1">
          Last checked <%= time_ago_in_words(@home_assistant[:polled_at]) %> ago
        </div>
      <% end %>
      <% if @home_assistant[:error].present? %>
        <div class="alert alert-warning mt-2 mb-0 text-13"><%= @home_assistant[:error] %></div>
      <% end %>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      <div class="h-section-label">Label printing</div>
      <p class="text-13 text-secondary mb-2">
        Configure CUPS label printers for print job pickup labels.
      </p>
      <%= link_to 'Label printers', label_printers_path, class: 'btn btn-outline-secondary btn-sm' %>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <div class="h-section-label">Printers</div>
      <% if @printers.any? %>
        <table class="table table-compact mb-0">
          <thead>
            <tr>
              <th>Name</th>
              <th>Hostname</th>
              <th>HA base sensor</th>
              <th>Camera</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @printers.each do |printer| %>
              <tr>
                <td><%= link_to printer.name, printer_path(printer) %></td>
                <td class="text-secondary text-13"><%= printer.hostname %></td>
                <td class="text-secondary text-13"><%= printer.ha_base_sensor.presence || '—' %></td>
                <td class="text-secondary text-13"><%= printer.camera? ? 'yes' : '—' %></td>
                <td class="text-end">
                  <%= link_to 'Edit', edit_printer_path(printer), class: 'btn btn-outline-secondary btn-sm' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-secondary mb-2">No printers configured yet.</p>
        <%= link_to '+ Add printer', new_printer_path, class: 'btn btn-primary btn-sm' %>
      <% end %>
    </div>
  </div>
</div>
