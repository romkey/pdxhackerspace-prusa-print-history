<div class="container py-4" style="max-width: 640px;">
  <div class="mb-3">
    <h1 class="h-page-title mb-0">Your notifications</h1>
    <div class="text-13 text-secondary mt-1">
      <% if @user.username.present? %>
        <span class="text-body"><%= @user.username %></span> &middot;
      <% end %>
      <%= @user.email %>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <%= form_with model: @user, url: profile_path, method: :patch, local: true do |f| %>
        <% if @user.errors.any? %>
          <div class="alert alert-danger text-13"><%= @user.errors.full_messages.to_sentence %></div>
        <% end %>

        <div class="h-section-label">Where to notify you</div>
        <p class="text-13 text-secondary">Used when your print finishes and when staff clear it from the printer.</p>

        <% if @user.email_notifications_available? %>
          <div class="form-check mb-2">
            <%= f.check_box :notify_via_email, class: 'form-check-input' %>
            <%= f.label :notify_via_email, "Email (#{@user.email})", class: 'form-check-label text-13' %>
          </div>
        <% else %>
          <p class="text-13 text-secondary mb-2">Email notifications are not available (SMTP is not configured).</p>
        <% end %>

        <% if @user.slack_id.present? %>
          <% if @user.slack_handle.present? %>
            <div class="text-13 mb-2">
              Slack <span class="text-body">@<%= @user.slack_handle %></span>
            </div>
          <% end %>

          <% if SlackConfig.configured? %>
            <div class="form-check mb-3">
              <%= f.check_box :notify_via_slack, class: 'form-check-input' %>
              <%= f.label :notify_via_slack, 'Slack direct message', class: 'form-check-label text-13' %>
            </div>
          <% else %>
            <p class="text-13 text-secondary mb-3">Slack notifications are not available (Slack is not configured).</p>
          <% end %>
        <% end %>

        <%= f.submit 'Save', class: 'btn btn-primary btn-sm' %>
      <% end %>
    </div>
  </div>
</div>
