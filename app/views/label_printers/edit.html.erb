<div class="container py-4" style="max-width: 880px;">
  <div class="mb-3">
    <div class="text-13 text-secondary">
      <%= link_to 'Settings', settings_path, class: 'text-decoration-none' %> /
      <%= link_to 'Label printers', label_printers_path, class: 'text-decoration-none' %>
    </div>
    <h1 class="h-page-title mb-0">Edit <%= @label_printer.name %></h1>
  </div>

  <div class="card">
    <div class="card-body">
      <%= render 'form', label_printer: @label_printer, cups_printers: @cups_printers %>

      <hr class="my-4">

      <%= button_to 'Remove printer', @label_printer, method: :delete,
                    class: 'btn btn-outline-danger btn-sm',
                    form: { data: { turbo_confirm: 'Remove this label printer?' } } %>
    </div>
  </div>
</div>
