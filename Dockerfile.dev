# syntax=docker/dockerfile:1
# check=error=true

# Development/test image. Source is bind-mounted at runtime from the host;
# the image only carries system packages and Node so the host's edits show
# up instantly without rebuilding.

ARG RUBY_VERSION=4.0.10
FROM docker.io/library/ruby:$RUBY_VERSION-slim

ENV LANG=C.UTF-8 \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_APP_CONFIG=/usr/local/bundle \
    BUNDLE_BIN=/usr/local/bundle/bin \
    PATH=/usr/local/bundle/bin:/rails/bin:$PATH

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
        build-essential \
        curl \
        cups-client \
        ffmpeg \
        git \
        libpq-dev \
        libvips \
        libyaml-dev \
        node-gyp \
        pkg-config \
        postgresql-client \
        python-is-python3 \
        tzdata \
        xz-utils && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

ARG NODE_VERSION=26.13.1
ARG TARGETARCH
RUN ARCH="$(case "${TARGETARCH}" in amd64) echo x64;; arm64) echo arm64;; *) echo "${TARGETARCH}";; esac)" && \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${ARCH}.tar.xz" | \
    tar -xJ -C /usr/local --strip-components=1 && \
    /usr/local/bin/npm install -g yarn@1.22.22

RUN gem install bundler -v 4.1.0 --no-document --install-dir "$(ruby -e 'puts Gem.default_dir')"

WORKDIR /rails

EXPOSE 3000

CMD ["bash"]
