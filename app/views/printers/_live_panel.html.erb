<% current_job = presenter.current_job %>
<% display_job = presenter.display_job %>
<% latest_reading = presenter.latest_reading %>
<% live_tool_temps = presenter.live_tool_temps %>
<% reported_tools = presenter.reported_tools %>
<% latest_photo = presenter.latest_photo %>

<% if display_job %>
  <% if (job_photos = presenter.photos)&.photos? %>
    <%= render 'jobs/photo_gallery', job: display_job, photos: job_photos, wrapper_class: 'mb-3' %>
  <% end %>
  <% if (timeline = presenter.timeline)&.renderable? %>
    <%= render 'jobs/timeline', job: display_job, timeline: timeline, wrapper_class: 'mb-3' %>
  <% end %>
<% end %>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card mb-3">
      <div class="card-body">
        <div class="h-section-label">Current job</div>
        <% if current_job %>
          <h2 class="h5 mb-2"><%= link_to current_job.filename, job_path(current_job) %></h2>
          <div class="text-13 text-secondary">
            <%= current_job.status %>
            <% if current_job.owner %>&middot; owner <%= current_job.owner.display_name %><% end %>
            <% if current_job.started_at %>&middot; started <%= time_ago_in_words(current_job.started_at) %> ago<% end %>
          </div>

          <%= render 'jobs/progress', job: current_job, wrapper_class: 'mt-2' %>

          <%= render 'jobs/preview', job: current_job, wrapper_class: 'mt-3' %>

          <table class="table table-compact mt-3 mb-0 text-13">
            <tbody>
              <tr><th class="text-secondary">PrusaLink job</th><td><%= current_job.prusalink_job_id.presence || '—' %></td></tr>
              <tr><th class="text-secondary">Filament used</th><td class="num"><%= current_job.total_filament_grams.present? ? "#{current_job.total_filament_grams.to_f.round(1)} g" : '—' %></td></tr>
              <tr><th class="text-secondary">Started</th><td><%= current_job.started_at ? l(current_job.started_at, format: :short) : '—' %></td></tr>
            </tbody>
          </table>

          <% if latest_reading %>
            <hr>
            <div class="row text-13">
              <div class="col">Bed<br><span class="fw-medium"><%= latest_reading.bed_temp.to_f.round(1) %> &deg;C</span></div>
              <% if latest_reading.tool_temp(0).present? %>
                <div class="col">Nozzle<br><span class="fw-medium"><%= latest_reading.tool_temp(0).to_f.round(1) %> &deg;C</span></div>
              <% end %>
              <div class="col">Enclosure<br><span class="fw-medium"><%= latest_reading.enclosure_temp.to_f.round(1) %> &deg;C</span></div>
              <div class="col">Humidity<br><span class="fw-medium"><%= latest_reading.enclosure_humidity.to_f.round(0) %>%</span></div>
            </div>
          <% end %>
        <% else %>
          <p class="text-secondary mb-0">Printer is idle.</p>
          <% if reported_tools.any? %>
            <div class="mt-3">
              <%= render 'jobs/tools',
                         tools: reported_tools,
                         section_label: 'Loaded print heads',
                         empty_message: 'No print head data yet.' %>
            </div>
          <% end %>
          <% if display_job %>
            <div class="text-13 text-secondary mt-2">
              Last job:
              <%= link_to display_job.filename, job_path(display_job), class: 'text-decoration-none' %>
              <% if display_job.ended_at %>
                finished <%= time_ago_in_words(display_job.ended_at) %> ago
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if display_job && presenter.chart_series.any? %>
      <div class="card mb-3">
        <div class="card-body">
          <div class="h-section-label">Temperatures</div>
          <%= render 'shared/temperature_chart',
                     chart_series: presenter.chart_series,
                     chart_options: presenter.chart_options %>
        </div>
      </div>
    <% end %>

    <% if display_job %>
      <div class="card mb-3">
        <div class="card-body">
          <div class="h-section-label">Job events</div>
          <% events = presenter.events %>
          <% if events.any? %>
            <ul class="list-unstyled mb-0">
              <% events.each do |event| %>
                <li class="d-flex justify-content-between border-bottom py-2 text-13">
                  <div>
                    <span class="fw-medium"><%= event.event_type.humanize %></span>
                    <span class="text-secondary">
                      <% if event.from_status %><%= event.from_status %> → <% end %><%= event.to_status %>
                    </span>
                  </div>
                  <div class="text-secondary" title="<%= l(event.occurred_at, format: :precise) %>">
                    <%= l(event.occurred_at, format: :short) %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <div class="text-secondary text-13 mb-0">No events recorded.</div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="card">
      <div class="card-body">
        <div class="h-section-label">Recent jobs</div>
        <% if presenter.recent_jobs.any? %>
          <table class="table table-compact mb-0">
            <thead>
              <tr>
                <th>File</th>
                <th>Status</th>
                <th>Owner</th>
                <th>Started</th>
              </tr>
            </thead>
            <tbody>
              <% presenter.recent_jobs.each do |job| %>
                <tr>
                  <td><%= link_to job.filename, job_path(job) %></td>
                  <td class="text-secondary"><%= job.status %></td>
                  <td class="text-secondary"><%= job.owner&.display_name || '—' %></td>
                  <td class="text-secondary text-13" title="<%= job.started_at && l(job.started_at, format: :precise) %>">
                    <%= job.started_at ? "#{time_ago_in_words(job.started_at)} ago" : '—' %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-secondary mb-0">No prints recorded yet.</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <% if printer.camera? %>
      <div class="card mb-3">
        <div class="card-body">
          <div class="h-section-label">Camera</div>
          <% if latest_photo&.image&.attached? %>
            <%= image_tag storage_blob_path(latest_photo.image),
                          class: 'img-fluid rounded border',
                          alt: "Camera view of #{printer.name}" %>
            <div class="text-12 text-secondary mt-1" title="<%= l(latest_photo.captured_at, format: :precise) %>">
              <%= time_ago_in_words(latest_photo.captured_at) %> ago
            </div>
          <% else %>
            <%= image_tag camera_printer_path(printer, t: presenter.camera_refresh_token),
                          class: 'img-fluid rounded border',
                          alt: "Camera view of #{printer.name}" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="card mb-3">
      <div class="card-body">
        <%= render 'jobs/tools',
                   tools: reported_tools,
                   live_tool_temps: live_tool_temps,
                   show_live_temps: current_job.present?,
                   section_label: 'Print heads',
                   empty_message: 'No print head data yet.' %>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-body">
        <div class="h-section-label">Environment</div>
        <% if printer.has_attribute?(:ambient_temp) && printer.ambient_temp.present? %>
          <div class="text-13">
            Ambient
            <div class="h5 mb-0 fw-medium"><%= printer.ambient_temp.to_f.round(1) %> &deg;C</div>
          </div>
          <% if printer.has_attribute?(:environment_updated_at) && printer.environment_updated_at %>
            <div class="text-12 text-secondary mt-2"
                 title="<%= l(printer.environment_updated_at, format: :precise) %>">
              Updated <%= time_ago_in_words(printer.environment_updated_at) %> ago
            </div>
          <% end %>
        <% else %>
          <div class="text-secondary text-13 mb-0">No ambient reading yet.</div>
        <% end %>

        <% if printer.has_attribute?(:enclosure_temp) && (printer.enclosure_temp.present? || printer.enclosure_humidity.present?) %>
          <div class="row text-13 mt-3">
            <% if printer.enclosure_temp.present? %>
              <div class="col">Enclosure<br><span class="fw-medium"><%= printer.enclosure_temp.to_f.round(1) %> &deg;C</span></div>
            <% end %>
            <% if printer.enclosure_humidity.present? %>
              <div class="col">Humidity<br><span class="fw-medium"><%= printer.enclosure_humidity.to_f.round(0) %>%</span></div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <% if respond_to?(:admin?) && admin? %>
      <div class="card">
        <div class="card-body">
          <div class="h-section-label">Integrations</div>
          <ul class="list-unstyled mb-0 text-13">
            <li>
              <span class="status-dot <%= printer.prusalink? ? 'status-success' : 'status-muted' %> me-2"></span>
              PrusaLink <%= printer.prusalink? ? 'configured' : 'not configured' %>
            </li>
            <li>
              <span class="status-dot <%= printer.home_assistant? ? 'status-success' : 'status-muted' %> me-2"></span>
              Home Assistant sensor: <%= printer.ha_base_sensor.presence || '—' %>
            </li>
            <li>
              <span class="status-dot <%= printer.camera_configured? ? 'status-success' : 'status-muted' %> me-2"></span>
              Camera: <%= printer.camera? ? printer.camera_url : (printer.prusalink? ? 'PrusaLink' : 'none') %>
            </li>
          </ul>
        </div>
      </div>
    <% end %>
  </div>
</div>
