<div class="container py-4">
  <div class="row">
    <div class="col-lg-8">
      <div class="mb-3">
        <div class="text-13 text-secondary">
          <%= link_to 'Service log', service_printer_path(@printer), class: 'text-decoration-none' %>
        </div>
        <h1 class="h-page-title mb-0">Take <%= @printer.name %> out of service</h1>
      </div>

      <%= form_with model: @entry, url: out_of_service_printer_path(@printer) do |f| %>
        <%= render 'errors', entry: @entry %>
        <div class="mb-3">
          <%= f.label :summary, 'Reason', class: 'form-label' %>
          <%= f.text_field :summary, class: 'form-control', required: true, maxlength: 200 %>
        </div>
        <%= f.submit 'Take out of service', class: 'btn btn-primary btn-sm' %>
      <% end %>
    </div>
  </div>
</div>
