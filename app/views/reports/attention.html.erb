<div class="container py-4">
  <div class="d-flex align-items-end justify-content-between mb-3">
    <div>
      <h1 class="h-page-title mb-0">Attention events by printer</h1>
      <div class="text-13 text-secondary mt-1">
        <%= attention_events_report_summary(@rows) %>
      </div>
    </div>
    <div class="d-flex gap-2">
      <%= link_to 'All reports', reports_path, class: 'btn btn-outline-secondary btn-sm' %>
    </div>
  </div>

  <%= render 'report_nav' %>

  <% if @chart_series.any? %>
    <div class="card mb-3">
      <div class="card-body">
        <div class="h-section-label mb-2">Attention events</div>
        <%= column_chart @chart_series,
                         height: '260px',
                         library: {
                           plugins: { legend: { labels: { boxWidth: 10, font: { size: 11 } } } },
                           scales: {
                             y: {
                               title: { display: true, text: 'Events', font: { size: 11 } },
                               ticks: { precision: 0 }
                             }
                           }
                         } %>
      </div>
    </div>
  <% end %>

  <% if @rows.any? %>
    <div class="card">
      <table class="table table-compact mb-0">
        <thead>
          <tr>
            <th>Printer</th>
            <th class="num">Last 7 days</th>
            <th class="num">Last 30 days</th>
            <th class="num">All time</th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <tr>
              <td><span class="<%= row.all_count.positive? ? 'fw-medium' : 'text-secondary' %>"><%= row.label %></span></td>
              <td class="num text-13"><%= format_report_count_cell(row.week_count) %></td>
              <td class="num text-13"><%= format_report_count_cell(row.month_count) %></td>
              <td class="num text-13"><%= format_report_count_cell(row.all_count) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-secondary">No attention events recorded yet.</p>
  <% end %>
</div>
