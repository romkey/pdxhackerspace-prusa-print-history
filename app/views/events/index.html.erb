<div class="container py-4">
  <div class="d-flex align-items-end justify-content-between mb-3">
    <div>
      <h1 class="h-page-title mb-0">Events</h1>
      <div class="text-13 text-secondary mt-1">
        <%= pluralize(@pagy.count, 'event') %>
        <% if @active_filters.any? %>
          · <%= pluralize(@active_filters.size, 'filter') %> active ·
          <%= link_to 'Clear', events_path, class: 'text-decoration-none' %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="d-flex flex-wrap gap-2 mb-3">
    <% EventListing::FILTER_EVENT_TYPES.each_key do |filter_name| %>
      <%= link_to event_filter_label(filter_name),
                  events_filter_href(filter_name),
                  class: events_filter_chip_class(filter_name) %>
    <% end %>
  </div>

  <% if @events.any? %>
    <div class="card">
      <table class="table table-compact mb-0">
        <thead>
          <tr>
            <th>When</th>
            <th>Printer</th>
            <th>Event</th>
            <th>Details</th>
            <th>Job</th>
          </tr>
        </thead>
        <tbody>
          <% @events.each do |event| %>
            <% printer = event_row_printer(event) %>
            <% job = event_row_job(event) %>
            <tr>
              <td class="text-secondary text-13" title="<%= l(event.occurred_at, format: :precise) %>">
                <%= l(event.occurred_at, format: :short) %>
              </td>
              <td>
                <%= link_to printer.name, printer_path(printer), class: 'text-decoration-none' %>
              </td>
              <td>
                <span class="status-dot <%= event_status_dot_class(event) %> me-1"></span>
                <%= event_row_label(event) %>
              </td>
              <td class="text-secondary text-13"><%= event_row_detail(event).presence || '—' %></td>
              <td>
                <% if job %>
                  <%= link_to job.filename, job_path(job), class: 'fw-medium text-decoration-none' %>
                <% else %>
                  <span class="text-secondary">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="mt-3">
        <%== pagy_bootstrap_nav(@pagy, anchor_string: ' data-turbo-action="advance"') %>
      </div>
    <% end %>
  <% else %>
    <p class="text-secondary">No events recorded yet.</p>
  <% end %>
</div>
