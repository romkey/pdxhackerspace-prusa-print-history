<% if job.preview_image.attached? %>
  <div class="<%= local_assigns[:wrapper_class] if local_assigns[:wrapper_class].present? %>">
    <div class="text-12 text-secondary mb-1">Print preview</div>
    <%= image_tag job.preview_image, class: 'img-fluid rounded border', alt: "Preview of #{job.filename}" %>
  </div>
<% end %>
