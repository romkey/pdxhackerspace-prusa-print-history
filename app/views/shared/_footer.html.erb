<footer class="border-top mt-4 py-3">
  <div class="container text-12 text-center text-secondary">
    <span><%= footer_text %></span>
    <% if footer_link_label.present? && footer_link_url.present? %>
      <span class="mx-1">&middot;</span>
      <%= link_to footer_link_label, footer_link_url, target: '_blank', rel: 'noopener' %>
    <% end %>
  </div>
</footer>
