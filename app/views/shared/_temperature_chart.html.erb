<% chart_options = local_assigns.fetch(:chart_options, {}) %>
<% if chart_series.any? %>
  <%= line_chart chart_series,
                 height: '220px',
                 **chart_options,
                 library: {
                   plugins: { legend: { labels: { boxWidth: 10, font: { size: 11 }, usePointStyle: true } } },
                   scales: {
                     y: {
                       title: { display: true, text: '°C', font: { size: 11 } }
                     }
                   }
                 },
                 points: false,
                 suffix: ' °C' %>
<% else %>
  <div class="text-secondary text-13 mb-0">No temperature readings recorded.</div>
<% end %>
