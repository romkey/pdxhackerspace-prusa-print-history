<% if photos.photos? %>
  <div class="<%= local_assigns[:wrapper_class] if local_assigns[:wrapper_class].present? %>">
    <div class="h-section-label">Print photos</div>

    <div class="row g-3">
      <% if (initial = photos.initial_photo) %>
        <div class="<%= photos.final_photo ? 'col-md-6' : 'col-12' %>">
          <div class="text-12 text-secondary mb-1"><%= photos.final_photo ? 'Start' : 'Progress' %></div>
          <%= image_tag storage_blob_path(initial.image), class: 'img-fluid rounded border', alt: "Start of #{job.filename}" %>
          <div class="text-12 text-secondary mt-1" title="<%= l(initial.captured_at, format: :precise) %>">
            <%= l(initial.captured_at, format: :short) %>
          </div>
        </div>
      <% end %>

      <% if (final = photos.final_photo) %>
        <div class="col-md-6">
          <div class="text-12 text-secondary mb-1"><%= photos.latest_photo_label %></div>
          <%= image_tag storage_blob_path(final.image),
                        class: 'img-fluid rounded border',
                        alt: "#{photos.latest_photo_label} of #{job.filename}" %>
          <div class="text-12 text-secondary mt-1" title="<%= l(final.captured_at, format: :precise) %>">
            <%= l(final.captured_at, format: :short) %>
          </div>
        </div>
      <% end %>
    </div>

    <% if photos.progress_photos.size > 1 %>
      <details class="mt-3">
        <summary class="text-13 text-secondary">
          Browse <%= pluralize(photos.progress_photos.size, 'progress photo') %>
        </summary>
        <div class="row g-2 mt-2">
          <% photos.progress_photos.each_with_index do |photo, index| %>
            <div class="col-6 col-md-4 col-lg-3">
              <%= image_tag storage_blob_path(photo.image),
                            class: 'img-fluid rounded border',
                            alt: "Progress photo #{index + 1} of #{job.filename}" %>
              <div class="text-12 text-secondary mt-1" title="<%= l(photo.captured_at, format: :precise) %>">
                <%= l(photo.captured_at, format: :short) %>
              </div>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>
<% end %>
