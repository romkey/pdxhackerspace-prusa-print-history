<div class="container py-4">
  <div class="d-flex align-items-end justify-content-between mb-3">
    <div>
      <h1 class="h-page-title mb-0">Overview</h1>
      <div class="text-13 text-secondary mt-1">
        <%= pluralize(@printers.size, 'printer') %> &middot;
        <span class="text-body"><%= @active_jobs.size %></span> active jobs
      </div>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-lg-6">
      <div class="card">
        <div class="card-body">
          <div class="h-section-label">Printers</div>
          <% if @printers.any? %>
            <table class="table table-compact mb-0">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Location</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% @printers.each do |printer| %>
                  <tr>
                    <td><%= link_to printer.name, printer_path(printer) %></td>
                    <td class="text-secondary"><%= printer.location.presence || '—' %></td>
                    <td>
                      <%= render 'shared/printer_status', printer: printer %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-13 text-secondary mb-0">
              No printers configured yet.
              <% if admin? %>
                <%= link_to 'Add one', new_printer_path %>.
              <% end %>
            </p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="card">
        <div class="card-body">
          <div class="h-section-label">Recent events</div>
          <% if @recent_events.any? %>
            <ul class="list-unstyled mb-0">
              <% @recent_events.each do |event| %>
                <li class="d-flex justify-content-between border-bottom py-2">
                  <div>
                    <%= link_to event.job.printer.name, printer_path(event.job.printer), class: 'fw-medium' %>
                    <span class="text-secondary">&middot;</span>
                    <%= link_to event.event_type, job_path(event.job), class: 'text-decoration-none' %>
                  </div>
                  <div class="text-secondary text-13"
                       title="<%= l(event.occurred_at, format: :precise) %>">
                    <%= time_ago_in_words(event.occurred_at) %> ago
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-13 text-secondary mb-0">No events yet.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
