#!/bin/bash -e

# Apply pending migrations before long-running app processes start.
# Skipped when SKIP_DB_MIGRATE=true (e.g. one-off console/shell containers).
prepare_database() {
  if [ "${SKIP_DB_MIGRATE:-}" = "true" ]; then
    return
  fi

  ./bin/rails db:prepare
}

if { [ "${1}" = './bin/rails' ] && [ "${2}" = 'server' ]; } || \
   { [ "${1}" = './bin/thrust' ] && [ "${2}" = './bin/rails' ] && [ "${3}" = 'server' ]; } || \
   { [ "${1}" = 'bundle' ] && [ "${2}" = 'exec' ] && [ "${3}" = 'sidekiq' ]; }; then
  prepare_database
fi

exec "${@}"
