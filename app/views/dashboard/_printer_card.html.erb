<% card = local_assigns.fetch(:card) %>
<% printer = card.printer %>
<% current_job = card.current_job %>

<div class="dashboard-printer-card h-100 text-center">
  <h2 class="dashboard-printer-name mb-2">
    <%= link_to printer.name, printer_path(printer), class: 'text-decoration-none text-body' %>
  </h2>

  <div class="dashboard-images mb-2">
    <div class="dashboard-image-wrap dashboard-image-wrap--<%= card.image_outline_status %> mb-2">
      <% if card.snapshot_attached? %>
        <%= link_to printer_path(printer) do %>
          <%= image_tag storage_blob_path(card.snapshot.image),
                        class: 'dashboard-image',
                        alt: "Camera view of #{printer.name}" %>
        <% end %>
      <% else %>
        <%= image_tag '/images/placeholder-photo.svg',
                      class: 'dashboard-image dashboard-image-placeholder',
                      alt: "No camera photo for #{printer.name}" %>
      <% end %>
    </div>

    <div class="dashboard-image-wrap dashboard-image-wrap--<%= card.image_outline_status %>">
      <% if card.preview_attached? %>
        <%= link_to job_path(card.preview_job) do %>
          <%= image_tag storage_blob_path(card.preview_job.preview_image),
                        class: 'dashboard-image',
                        alt: "Preview of #{card.preview_job.filename}" %>
        <% end %>
      <% else %>
        <%= image_tag '/images/placeholder-preview.svg',
                      class: 'dashboard-image dashboard-image-placeholder',
                      alt: "No preview for #{printer.name}" %>
      <% end %>
    </div>
  </div>

  <div class="text-13 mb-1">
    <%= render 'shared/printer_status', printer: printer %>
  </div>

  <% if card.current_job %>
    <div class="dashboard-job-filename text-13 mb-2">
      <%= link_to card.current_job.filename, job_path(card.current_job), class: 'fw-medium text-decoration-none' %>
      <div class="text-12 text-secondary">
        <%= card.current_job.status %>
      </div>
      <%= render 'jobs/progress', job: card.current_job, wrapper_class: 'mt-2' %>
    </div>
  <% elsif card.idle? && card.last_job %>
    <div class="dashboard-job-filename text-13 mb-2">
      <%= link_to card.last_job.filename, job_path(card.last_job), class: 'fw-medium text-decoration-none' %>
      <div class="text-12 text-secondary">
        <%= card.last_job.status %>
        <% if card.last_job.ended_at %>
          <span title="<%= l(card.last_job.ended_at, format: :precise) %>">
            &middot; <%= time_ago_in_words(card.last_job.ended_at) %> ago
          </span>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="dashboard-temps text-start mx-auto mb-2">
    <div class="text-11 text-secondary mb-1">Temperatures &deg;C</div>
    <table class="table table-compact table-borderless mb-0 w-100">
      <tbody>
        <tr>
          <th class="text-secondary fw-normal">Bed</th>
          <td class="num text-end"><%= dashboard_temp_label(card.bed_temp_c) %></td>
        </tr>
        <tr>
          <th class="text-secondary fw-normal">Nozzle</th>
          <td class="num text-end"><%= dashboard_temp_label(card.nozzle_temp_c) %></td>
        </tr>
        <tr>
          <th class="text-secondary fw-normal">Enclosure</th>
          <td class="num text-end"><%= dashboard_temp_label(card.enclosure_temp_c) %></td>
        </tr>
        <tr>
          <th class="text-secondary fw-normal">Ambient</th>
          <td class="num text-end"><%= dashboard_temp_label(card.ambient_temp_c) %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="text-13 text-secondary d-flex justify-content-center gap-3">
    <span><i class="bi bi-disc me-1"></i><%= card.material_label %></span>
    <span><i class="bi bi-caret-down-fill me-1"></i><%= card.nozzle_label %></span>
  </div>
</div>
