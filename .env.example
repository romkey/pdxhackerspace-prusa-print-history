# Copy to .env (or .env.production) and fill in values.
# .env is loaded by dotenv-rails in development/test.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=prusa_print_history_development
# Or, for production, a single URL takes precedence over the DB_* vars:
# DATABASE_URL=postgres://user:pass@host:5432/prusa_print_history_production

# Redis (used by Sidekiq and ActiveJob)
REDIS_URL=redis://localhost:6379/0

# Rails
# RAILS_ENV=development
# RAILS_MAX_THREADS=5
# IANA timezone for displaying dates/times (defaults to UTC)
TIMEZONE=America/Los_Angeles
# Required for production:
# SECRET_KEY_BASE=
# APP_VERSION=
# APP_HOST=prusa-history.example.com

# Home Assistant (used for enclosure/humidity/ambient sensors)
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=replace-me

# Active Record encryption keys. Generate with:
#   bin/rails db:encryption:init
# and paste the three values here.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=replace_with_32+_random_chars
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=replace_with_32+_random_chars
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=replace_with_32+_random_chars

# Authentik (OIDC). Configure an OIDC application in Authentik and
# paste the issuer URL plus client credentials here.
AUTHENTIK_ISSUER=https://authentik.example.com/application/o/prusa-print-history/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:3000/auth/authentik/callback

# Set to true to log Authentik OIDC authorize params and HTTP JSON request/response
# bodies (secrets and tokens are redacted).
# AUTHENTIK_DEBUG=true

# Comma- or whitespace-separated list of emails that are auto-promoted to
# admin on first sign-in.
ADMIN_EMAILS=

# Slack Bot token with chat:write (and users:read if syncing handles).
# Used to DM claimants when a print label is printed.
SLACK_API_TOKEN=

# Email (SMTP) — required to notify claimants by email when printing labels.
# Without SMTP_SERVER, email notifications are disabled.
MAIL_FROM=noreply@example.com
SMTP_SERVER=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_DOMAIN=example.com
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
# Set SMTP_SSL=false for local mail servers that do not support TLS/SSL (e.g. Mailpit).
# SMTP_SSL=true

# Optional organization name shown on printed labels.
# ORGANIZATION_NAME=PDX Hackerspace

# Comma-separated IPv4 CIDR blocks (e.g. 192.168.0.0/24,10.0.50.0/24) that
# may view jobs/printers and clear prints without signing in. Client IP is
# taken from X-Forwarded-For when the request comes through a trusted proxy.
# INTERNAL_NETWORKS=192.168.0.0/24

# Public hostname (used for URL generation in production).
APP_HOST=prusa-history.example.com

# TLS — all optional. Defaults allow plain HTTP (no redirect, non-Secure cookies).
# APP_PROTOCOL=http
# RAILS_FORCE_SSL=false
# RAILS_ASSUME_SSL=false
# SESSION_COOKIE_SECURE=false
#
# To require HTTPS in production:
#   APP_PROTOCOL=https
#   RAILS_FORCE_SSL=true
#   SESSION_COOKIE_SECURE=true

# Optional password-based admin account (no Authentik required).
# Enabled when both LOCAL_ADMIN_EMAIL and LOCAL_ADMIN_PASSWORD are set.
LOCAL_ADMIN_EMAIL=admin@localhost
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_NAME=Local Admin

# docker-compose.server.yml
# IMAGE=ghcr.io/<owner>/prusa-print-history:latest
# WEB_PORT=3000
