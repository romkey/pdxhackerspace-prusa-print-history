<div class="container py-4">
  <div class="d-flex align-items-end justify-content-between mb-3">
    <div>
      <div class="text-13 text-secondary">
        <%= link_to 'Jobs', jobs_path, class: 'text-decoration-none' %> /
        <%= link_to @job.printer.name, printer_path(@job.printer), class: 'text-decoration-none' %>
      </div>
      <h1 class="h-page-title mb-0"><%= @job.filename %></h1>
      <div class="text-13 text-secondary mt-1">
        <span class="badge text-bg-secondary-subtle"><%= @job.status %></span>
        <% if @job.started_at %>&middot; started <%= l(@job.started_at, format: :short) %><% end %>
        <% if @job.ended_at %>&middot; ended <%= l(@job.ended_at, format: :short) %><% end %>
        <% if @job.duration_seconds %>&middot; <%= distance_of_time_in_words(@job.duration_seconds) %><% end %>
      </div>
      <% if @tools.any? %>
        <div class="text-13 text-secondary mt-1">
          <% @tools.each_with_index do |tool, index| %>
            <% if index.positive? %>&middot; <% end %>
            <span><%= tool.label %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%= render 'jobs/preview', job: @job, wrapper_class: 'mb-3' %>
  <%= render 'jobs/photo_gallery', job: @job, photos: @photos, wrapper_class: 'mb-3' %>

  <% if admin? && (@job.clearable? || @job.cleared?) %>
    <%= render 'jobs/clear_print', job: @job, label_printers: @label_printers, default_label_printer: @default_label_printer %>
  <% end %>

  <div class="row g-3">
    <div class="col-lg-7">
      <div class="card mb-3">
        <div class="card-body">
          <%= render 'jobs/tools', tools: @tools, section_label: 'Print heads used' %>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-body">
          <div class="h-section-label">Owner</div>
          <% if @job.owner %>
            <div class="fw-medium"><%= @job.owner.display_name %></div>
            <div class="text-secondary text-13"><%= @job.owner.email %></div>
            <% if @job.owner.slack_id.present? %>
              <div class="text-secondary text-13">Slack <%= @job.owner.slack_id %></div>
            <% end %>
          <% else %>
            <div class="text-secondary">No owner.</div>
          <% end %>

          <% if admin? && @job.owner %>
            <div class="mt-3">
              <%= form_with model: @job.owner, url: user_path(@job.owner), method: :patch, local: true,
                            class: 'd-flex gap-2 align-items-end' do |f| %>
                <div class="flex-grow-1">
                  <%= f.label :slack_id, 'Slack user ID', class: 'form-label text-13' %>
                  <%= f.text_field :slack_id, class: 'form-control form-control-sm', placeholder: 'U0123456789' %>
                </div>
                <%= f.submit 'Save', class: 'btn btn-outline-secondary btn-sm' %>
              <% end %>
            </div>
          <% end %>

          <% if logged_in? %>
            <div class="mt-3 d-flex gap-2">
              <% if @job.owner.nil? || @job.owner_id != current_user.id %>
                <%= button_to 'Claim', claim_job_path(@job), method: :patch, class: 'btn btn-outline-secondary btn-sm' %>
              <% end %>
              <% if @job.owner_id == current_user.id %>
                <%= button_to 'Release', claim_job_path(@job), method: :delete, class: 'btn btn-outline-secondary btn-sm' %>
              <% end %>
              <% if admin? && @job.owner %>
                <%= button_to "Force release (admin)", claim_job_path(@job), method: :delete, class: 'btn btn-outline-danger btn-sm' %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <% if @chart_series.any? %>
        <div class="card mb-3">
          <div class="card-body">
            <div class="h-section-label">Temperatures</div>
            <%= render 'shared/temperature_chart', chart_series: @chart_series, chart_options: @chart_options %>
          </div>
        </div>
      <% end %>

      <div class="card">
        <div class="card-body">
          <div class="h-section-label">Events</div>
          <% if @events.any? %>
            <ul class="list-unstyled mb-0">
              <% @events.each do |event| %>
                <li class="d-flex gap-3 border-bottom py-2">
                  <div style="width: 96px;">
                    <% if event.photo.attached? %>
                      <%= image_tag storage_blob_path(event.photo), class: 'img-fluid rounded', style: 'max-height: 64px;' %>
                    <% else %>
                      <div class="text-secondary text-13">No photo</div>
                    <% end %>
                  </div>
                  <div class="flex-grow-1">
                    <div class="fw-medium"><%= event.event_type.humanize %></div>
                    <div class="text-13 text-secondary">
                      <% if event.from_status %><%= event.from_status %> → <% end %><%= event.to_status %>
                      <% if event.message %>&middot; <%= event.message %><% end %>
                    </div>
                  </div>
                  <div class="text-secondary text-13" title="<%= l(event.occurred_at, format: :precise) %>">
                    <%= l(event.occurred_at, format: :short) %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <div class="text-secondary">No events recorded.</div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card">
        <div class="card-body">
          <div class="h-section-label">Latest telemetry</div>
          <% if @latest_reading %>
            <table class="table table-compact mb-0">
              <tbody>
                <tr><th>Recorded</th><td class="text-secondary"><%= l(@latest_reading.recorded_at, format: :short) %></td></tr>
                <tr><th>Bed</th><td><%= @latest_reading.bed_temp.to_f.round(1) %> &deg;C</td></tr>
                <tr><th>Enclosure</th><td><%= @latest_reading.enclosure_temp.to_f.round(1) %> &deg;C</td></tr>
                <tr><th>Ambient</th><td><%= @latest_reading.ambient_temp.to_f.round(1) %> &deg;C</td></tr>
                <tr><th>Humidity</th><td><%= @latest_reading.enclosure_humidity.to_f.round(0) %>%</td></tr>
              </tbody>
            </table>

            <% if @latest_reading.tool_temps.present? %>
              <div class="h-section-label mt-3">Tools</div>
              <table class="table table-compact mb-0">
                <tbody>
                  <% @latest_reading.tool_temps.sort_by { |k, _| k.to_i }.each do |index, temp| %>
                    <tr><th>T<%= index %></th><td><%= temp.to_f.round(1) %> &deg;C</td></tr>
                  <% end %>
                </tbody>
              </table>
            <% end %>
          <% else %>
            <div class="text-secondary">No readings yet.</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
